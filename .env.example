# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is loaded automatically at startup and is git-ignored (see .gitignore).
# Environment variables already set in the real environment always take
# precedence over values defined here, so container-level configuration still
# wins when a .env file happens to be present.

# ---------------------------------------------------------------------------
# Google Calendar credentials — all optional.
#
# If none of the options below are set, Application Default Credentials (ADC)
# are used, which is the natural fit when running on GCP (Cloud Run, GKE,
# GCE, Workload Identity): the platform provides tokens, nothing to configure.
#
# Option 1: raw contents of the service account key JSON.
# Multi-line JSON is supported — wrap the whole value in SINGLE quotes:
#
#   GOOGLE_CREDENTIALS_JSON='{
#     "type": "service_account",
#     "project_id": "my-project",
#     ...
#   }'
#
# Do not use double quotes: godotenv expands \n escape sequences inside
# double-quoted values, which corrupts the newlines embedded in
# "private_key" and makes the JSON invalid. Single quotes preserve
# the content verbatim.
GOOGLE_CREDENTIALS_JSON=

# Option 2: path to the service account key file on disk.
GOOGLE_CREDENTIALS_FILE=

# Option 3: ADC also honors GOOGLE_APPLICATION_CREDENTIALS (a path to a key
# file), but on GCP prefer plain ADC / Workload Identity over key files.

# ---------------------------------------------------------------------------
# Required
#
# ID of the calendar to read. For a personal calendar this is usually your
# email address (Google Calendar → Settings → "Integrate calendar").
GOOGLE_CALENDAR_ID=

# ---------------------------------------------------------------------------
# Required
#
# Microsoft Teams workflow (Power Automate) incoming webhook URL.
MSTEAM_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Optional
#
# Port the HTTP server listens on. Cloud Run injects PORT=8080 and it takes
# precedence automatically; locally the default is 1323.
# PORT=1323

# IANA timezone used to resolve "today" (default: Asia/Bangkok).
CALENDAR_TIMEZONE=Asia/Bangkok

# Log level: debug, info, warn or error (default: info).
LOG_LEVEL=info